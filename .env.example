# Copy to .env and fill in. Without a Google key the app runs on built-in demo data.

# Server-side key: needs "Places API (New)" and "Routes API" enabled.
GOOGLE_MAPS_API_KEY=

# Browser key for the interactive map: needs "Maps JavaScript API".
# Restrict it to your site's URL (HTTP referrer restriction). Leave empty to use the simple schematic map.
GOOGLE_MAPS_BROWSER_KEY=

# Optional Map ID (Google Cloud > Map Management) for styled vector maps. Defaults to Google's DEMO_MAP_ID.
GOOGLE_MAPS_MAP_ID=

# auto = Google when a key is set, otherwise demo data. Force with "google" or "demo".
DATA_SOURCE=auto

# Port the web app is published on.
WEB_PORT=3004

# Postgres password (the database is only reachable inside the compose network).
POSTGRES_PASSWORD=change-me

# How long identical Google requests are reused (minutes). Re-planning repeats many searches.
CACHE_TTL_MINUTES=360

# Trip planning calls Google many times; this caps plans/regenerations per IP per hour.
PLANS_PER_HOUR_PER_IP=60

# Each swap/add-a-stop search (category change, "Search this area", "Show more") is one Google call.
SEARCHES_PER_HOUR_PER_IP=300

LOG_LEVEL=info
